{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Active"
        },
        {
            "type": "Select",
            "name": "Country",
            "caption": "Dreamehome region",
            "options": [
                {
                    "caption": "Europe (Germany / Switzerland)",
                    "value": "de"
                }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "Username",
            "caption": "Dreamehome email or phone number"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Dreamehome password"
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceID",
            "caption": "Device ID (optional)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update interval",
            "suffix": " seconds",
            "minimum": 30,
            "maximum": 3600
        },
        {
            "type": "Label",
            "caption": "The cloud interface is unofficial. Do not publish debug logs containing account or device data."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Test login and find devices",
            "onClick": "echo DRM_TestConnection($id);"
        },
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "DRM_Update($id);"
        },
        {
            "type": "Button",
            "caption": "List Dreame shortcuts",
            "onClick": "echo DRM_ListShortcuts($id);"
        },
        {
            "type": "Button",
            "caption": "Test live map",
            "onClick": "echo DRM_TestMap($id);"
        }
    ],
    "status": [
        {
            "code": 200,
            "icon": "error",
            "caption": "Credentials are missing"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Dreamehome login failed"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No matching robot found"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Communication error"
        }
    ]
}
