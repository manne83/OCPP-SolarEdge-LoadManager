{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Active"
        },
        {
            "type": "List",
            "name": "Jobs",
            "caption": "Parallel cleaning plan",
            "add": true,
            "delete": true,
            "sort": {
                "column": "JobID",
                "direction": "ascending"
            },
            "columns": [
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "80px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Job ID",
                    "name": "JobID",
                    "width": "150px",
                    "add": "new_job",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Robot instance",
                    "name": "InstanceID",
                    "width": "240px",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance",
                        "validModules": [
                            "{6B87C506-2B66-48BB-8E1C-EA41DDE8D353}"
                        ]
                    }
                },
                {
                    "caption": "Area",
                    "name": "Area",
                    "width": "170px",
                    "add": "area_1",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Shortcut ID",
                    "name": "ShortcutID",
                    "width": "100px",
                    "add": 25,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 25,
                        "maximum": 128
                    }
                },
                {
                    "caption": "Result",
                    "name": "Role",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Vacuumed",
                                "value": 0
                            },
                            {
                                "caption": "Mopped",
                                "value": 1
                            },
                            {
                                "caption": "Vacuumed and mopped",
                                "value": 2
                            }
                        ]
                    }
                },
                {
                    "caption": "Wait for job IDs",
                    "name": "DependsOn",
                    "width": "190px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Additional locks",
                    "name": "Locks",
                    "width": "170px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Coordinator interval",
            "suffix": " seconds",
            "minimum": 10,
            "maximum": 60
        },
        {
            "type": "NumberSpinner",
            "name": "StepTimeout",
            "caption": "Maximum duration per robot",
            "suffix": " minutes",
            "minimum": 30,
            "maximum": 720
        },
        {
            "type": "Label",
            "caption": "Create room or zone shortcuts in Dreamehome first. Jobs can run simultaneously when robot, area and additional locks do not overlap. Enter lists separated by commas."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Start cleaning sequence",
            "onClick": "DRMC_StartSequence($id);"
        },
        {
            "type": "Button",
            "caption": "Pause active robots",
            "onClick": "DRMC_PauseSequence($id);"
        },
        {
            "type": "Button",
            "caption": "Continue cleaning sequence",
            "onClick": "DRMC_ResumeSequence($id);"
        },
        {
            "type": "Button",
            "caption": "Abort and return all robots",
            "onClick": "DRMC_AbortSequence($id);"
        }
    ],
    "status": [
        {
            "code": 200,
            "icon": "error",
            "caption": "No valid robot sequence configured"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Cleaning sequence stopped with an error"
        }
    ]
}
